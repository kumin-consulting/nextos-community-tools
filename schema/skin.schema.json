{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/kumin-consulting/nextos-community-tools/main/schema/skin.schema.json",
  "title": "NextOS skin",
  "description": "A skin: one JSON object saying what the whole of NextOS should look like. Generated from lib/os/skins/types.ts in kumin-consulting/jonkum.in by scripts/build-skin-schema.mjs - edit that, not this.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "description",
    "createdAt",
    "updatedAt",
    "base",
    "tokens",
    "cell",
    "app",
    "type",
    "sky",
    "layout",
    "wallpaper"
  ],
  "properties": {
    "format": {
      "const": "nextos-skin"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64,
      "description": "The slug. In the community repository it also has to equal the tool folder name."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 60,
      "maxLength": 160,
      "description": "One plain sentence: this is the listing's summary, so it has to say something rather than repeat the name."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "base": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "description": "Which app theme the skin paints. Drives <html data-theme> while the skin is active."
    },
